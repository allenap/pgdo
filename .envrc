#!/usr/bin/env bash

# Put our scripts at the front of `PATH`.
PATH_add "$PWD/bin"

# Find `bin` folders on Linux and Homebrew systems and add them all to `PATH`,
# like CI does, so that tests run against every runtime. `PATH_add` prepends, so
# add them oldest first; the newest then ends up at the front of `PATH`. At
# least one `bin` directory for a supported version of PostgreSQL needs to be on
# `PATH` for tests to pass.
case $(uname -s) in
    Darwin) bins=(/opt/homebrew/opt/postgresql@*/bin) ;;
     Linux) bins=(/usr/lib/postgresql/*/bin) ;;
         *) bins=() ;;
esac

while IFS= read -r dir; do
    if [ -d "${dir}" ]; then
        PATH_add "${dir}"
    fi
done < <(printf '%s\n' "${bins[@]}" | sort -V)

unset dir bins

# End.
